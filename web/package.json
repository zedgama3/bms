{
  "name": "bms-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "generate:messages": "node scripts/generate-messages.mjs",
    "generate:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity error",
    "licenses": "node scripts/check-licenses.mjs",
    "build": "vite build",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "generate:messages:check": "node scripts/generate-messages.mjs --check",
    "imports": "bash ../scripts/check-web-module-imports.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.50.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.3",
    "react-router": "8.4.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@stoplight/spectral-cli": "6.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "openapi-typescript-helpers": "0.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
