        "properties": {
          "greeting": {
            "type": "string"
          },
          "mine": {
            "type": "integer"
          },
          "seen": {
            "type": "integer"
          }
        },
        "required": [
          "greeting",
          "mine",
          "seen"
        ],
        "type": "object"
      },
      "HelloPublicGreeting": {
        "properties": {
          "banners": {
            "items": {
              "$ref": "#/components/schemas/HelloBanner"
            },
            "type": "array"
