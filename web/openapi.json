      "ClientErrorBatch": {
        "properties": {
          "reports": {
            "items": {
              "properties": {
                "api": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "method": {
                      "type": "string"
                    },
                    "route": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "app_version": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "error_ref": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "crash",
                    "rejection",
                    "screen",
                    "api"
                  ],
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "occurred_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "screen": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                },
                "trace_id": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "message",
                "occurred_at"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "reports"
        ],
        "type": "object"
      },
      "Field": {
        "properties": {
          "code": {
            "description": "A machine-readable rule code: required, range, one_of, url, host_port, positive, malformed, ...",
            "type": "string"
          },
          "field": {
            "description": "The dotted path of the input.",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The rule's parameters, never the input.",
            "type": "object"
          },
          "reason": {
            "description": "The rule in English; shown only when the code has no translation.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "reason"
        ],
        "type": "object"
      },
