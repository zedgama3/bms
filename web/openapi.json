                    "subscribes": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "uses": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "properties": {
                    "message": {
                      "type": "string"
