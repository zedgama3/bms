    "/api/audit/entries": {
      "get": {
        "operationId": "auditSearch",
        "parameters": [
          {
            "description": "The person who acted.",
            "in": "query",
            "name": "actor",
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "description": "The person the record is about.",
            "in": "query",
            "name": "subject",
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "description": "The kind of the record acted on; needs record_id.",
            "in": "query",
            "name": "record_kind",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The record acted on; needs record_kind.",
            "in": "query",
            "name": "record_id",
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "description": "The area of the action: the text before its first dot.",
            "in": "query",
            "name": "area",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "One action, exactly.",
            "in": "query",
            "name": "action",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Start of the time range (inclusive); needs to.",
            "in": "query",
            "name": "from",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "End of the time range (exclusive); needs from.",
            "in": "query",
            "name": "to",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Only entries made by the superuser account.",
            "in": "query",
            "name": "superuser",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "The next value of the previous page.",
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size; 0 or absent means 50.",
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            },
            "description": "One page of entries."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "summary": "Search the audit log, newest first. Needs audit.search. The search is itself recorded.",
        "tags": [
          "audit"
        ]
      }
    },
