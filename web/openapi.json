        "properties": {
          "key": {
            "type": "string"
          },
          "module": {
            "type": "string"
          }
        },
        "required": [
          "module",
          "key"
        ],
        "type": "object"
      },
      "HelloGreeted": {
        "properties": {
          "created_at": {
            "format": "date-time",
