  "info": {
    "title": "BMS API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/modules": {
      "get": {
        "operationId": "adminModules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminModulesResponse"
                }
              }
            },
            "description": "The graph, the build version and each migration set's state."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "summary": "The module graph and schema versions. Needs core.modules.read.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/client-errors": {
      "post": {
        "operationId": "reportClientErrors",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientErrorBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted; no body."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The batch is invalid."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is over 64 KiB."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not JSON."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many reports; see Retry-After."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "security": [],
        "summary": "Report errors the web shell caught.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/hello/greeting": {
      "get": {
        "operationId": "helloGreeting",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloGreeting"
                }
              }
            },
            "description": "The greeting and counts."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "summary": "The greeting word and the actor's counts. Needs hello.greetings.read.",
        "tags": [
          "hello"
        ]
      }
    },
    "/api/hello/greetings": {
      "post": {
        "operationId": "helloGreet",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloGreeted"
                }
              }
            },
            "description": "The greeting was saved."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "summary": "Greet. Needs hello.greetings.write.",
        "tags": [
          "hello"
        ]
      }
    },
    "/api/hello/public-greeting": {
      "get": {
        "operationId": "helloPublicGreeting",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloPublicGreeting"
                }
              }
            },
            "description": "The greeting and banners."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "security": [],
        "summary": "The greeting word and the banners every visitor sees.",
        "tags": [
          "hello"
        ]
      }
    },
    "/api/modules": {
      "get": {
        "operationId": "listModules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModulesResponse"
                }
              }
            },
            "description": "Names and enablement only."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "security": [],
        "summary": "The compiled-in modules and whether each is enabled.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The OpenAPI 3.1 document."
          },
          "304": {
            "description": "Not modified."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An error. The body is a Problem."
          }
        },
        "security": [],
        "summary": "This document.",
        "tags": [
          "core"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "The shell's own endpoints.",
      "name": "core"
    },
    {
      "description": "The reference module.",
      "name": "hello"
    }
  ]
}
