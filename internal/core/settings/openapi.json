{
  "tags": [
    {"name": "settings", "description": "What the regional configures while bms runs: values, terminology and the public document."}
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["settings"],
        "operationId": "settingsDocument",
        "summary": "Every declared setting with its default and value. Needs settings.read. A secret is reported as secret_set only.",
        "responses": {
          "200": {
            "description": "The settings document.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsDocument"}}}
          }
        }
      }
    },
    "/values": {
      "put": {
        "tags": ["settings"],
        "operationId": "settingsSet",
        "summary": "Change settings, all or nothing: a string sets, null resets to the default. Needs settings.manage. Field errors name the full setting key. 501 when a secret is set and the deployment has no sealing key; 503 read_only on a read-only copy.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsChanges"}}}
        },
        "responses": {
          "200": {
            "description": "The revision after the change.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsRevision"}}}
          }
        }
      }
    },
    "/terms": {
      "get": {
        "tags": ["settings"],
        "operationId": "settingsTerms",
        "summary": "Every term in every language, with its default and its override. Needs settings.read.",
        "responses": {
          "200": {
            "description": "The terminology document.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsTermsDocument"}}}
          }
        }
      }
    },
    "/terms/{lang}": {
      "put": {
        "tags": ["settings"],
        "operationId": "settingsSetTerms",
        "summary": "Change the forms of terms in one language, all or nothing. Needs settings.manage. A null or absent form is unchanged; reset names forms to put back to the default.",
        "parameters": [
          {"name": "lang", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsTermChanges"}}}
        },
        "responses": {
          "200": {
            "description": "The revision after the change.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsRevision"}}}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SettingsDocument": {
        "type": "object",
        "required": ["revision", "areas"],
        "properties": {
          "revision": {"type": "integer", "format": "int64"},
          "areas": {"type": "array", "items": {"$ref": "#/components/schemas/SettingsArea"}}
        }
      },
      "SettingsArea": {
        "type": "object",
        "required": ["name", "core", "settings"],
        "properties": {
          "name": {"type": "string"},
          "core": {"type": "boolean"},
          "settings": {"type": "array", "items": {"$ref": "#/components/schemas/SettingsSetting"}}
        }
      },
      "SettingsSetting": {
        "type": "object",
        "required": ["key", "kind", "default", "value", "secret_set", "stale"],
        "properties": {
          "key": {"type": "string", "description": "The full key, <area>.<key>."},
          "kind": {"type": "string", "enum": ["bool", "int", "duration", "text", "enum", "secret"]},
          "default": {"type": "string", "description": "Empty for a secret."},
          "value": {"type": ["string", "null"], "description": "Null while the default applies; always null for a secret."},
          "secret_set": {"type": "boolean"},
          "options": {"type": "array", "items": {"type": "string"}, "description": "An enum's options."},
          "stale": {"type": "boolean", "description": "A stored value no longer parses and the default applies."}
        }
      },
      "SettingsChanges": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "values": {
            "type": "object",
            "description": "Full setting key to its new text value; null resets it. 1 to 200 keys.",
            "additionalProperties": {"type": ["string", "null"]}
          }
        }
      },
      "SettingsRevision": {
        "type": "object",
        "required": ["revision"],
        "properties": {"revision": {"type": "integer", "format": "int64"}}
      },
      "SettingsForms": {
        "type": "object",
        "required": ["singular", "plural", "singular_title", "plural_title"],
        "properties": {
          "singular": {"type": "string"},
          "plural": {"type": "string"},
          "singular_title": {"type": "string"},
          "plural_title": {"type": "string"}
        }
      },
      "SettingsFormChanges": {
        "type": "object",
        "properties": {
          "singular": {"type": ["string", "null"]},
          "plural": {"type": ["string", "null"]},
          "singular_title": {"type": ["string", "null"]},
          "plural_title": {"type": ["string", "null"]},
          "reset": {"type": "array", "items": {"type": "string", "enum": ["singular", "plural", "singular_title", "plural_title"]}}
        }
      },
      "SettingsTerm": {
        "type": "object",
        "required": ["area", "default", "override"],
        "properties": {
          "area": {"type": "string", "description": "\"core\" for a core term, else the name of the module that declares it."},
          "default": {"$ref": "#/components/schemas/SettingsForms"},
          "override": {"$ref": "#/components/schemas/SettingsFormChanges"}
        }
      },
      "SettingsTermsDocument": {
        "type": "object",
        "required": ["languages", "terms"],
        "properties": {
          "languages": {"type": "array", "items": {"type": "string"}},
          "terms": {
            "type": "object",
            "description": "Language, then term.",
            "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/SettingsTerm"}}
          }
        }
      },
      "SettingsTermChanges": {
        "type": "object",
        "required": ["terms"],
        "properties": {
          "terms": {
            "type": "object",
            "description": "Term to its form changes; 1 to as many terms as are declared.",
            "additionalProperties": {"$ref": "#/components/schemas/SettingsFormChanges"}
          }
        }
      }
    }
  }
}
