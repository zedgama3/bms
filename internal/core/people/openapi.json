{
  "tags": [
    {
      "name": "people",
      "description": "Who each participant is: profiles, emergency contacts, consents and search."
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "tags": [
          "people"
        ],
        "operationId": "peopleMe",
        "summary": "Your own profile, every field group, contacts, consents and the modules' sections. A person with no row yet gets an empty, incomplete profile (nothing is written). Read by the frame at boot. On a writable copy, when you have no playa name and have not been prompted since you signed in, this call records the prompt and answers first_prompt true once; a later read of the same session, a named person, the superuser and a read-only copy answer without it.",
        "responses": {
          "200": {
            "description": "Your profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleProfile"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "people"
        ],
        "operationId": "peopleUpdateMe",
        "summary": "Change your own profile; absent or null fields are unchanged and an empty string clears one. 400 playa_name required, legal_name or phone required when the regional requires them, hidden for a field the regional turned off, has_account for contact_email, malformed, too_long, control_chars; 400 playa_name permanent when a name is already set and the new one has another key (the same name, or a respelling with the same key, is accepted); 409 (field playa_name, code taken) when another person already uses the name.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleProfileInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Your profile after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleProfile"
                }
              }
            }
          }
        }
      }
    },
    "/me/contacts": {
      "post": {
        "tags": [
          "people"
        ],
        "operationId": "peopleAddMyContact",
        "summary": "Add an emergency contact. 400 contacts too_many {max} at ten, hidden when the regional turned contacts off.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleContactInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleContact"
                }
              }
            }
          }
        }
      }
    },
    "/me/contacts/{contact}": {
      "put": {
        "tags": [
          "people"
        ],
        "operationId": "peopleUpdateMyContact",
        "summary": "Replace one of your emergency contacts. 404 when it is not yours.",
        "parameters": [
          {
            "name": "contact",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleContactInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleContact"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "people"
        ],
        "operationId": "peopleRemoveMyContact",
        "summary": "Remove one of your emergency contacts. 404 when it is not yours.",
        "parameters": [
          {
            "name": "contact",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed."
          }
        }
      }
    },
    "/me/consents/{purpose}": {
      "put": {
        "tags": [
          "people"
        ],
        "operationId": "peopleSetMyConsent",
        "summary": "Grant or revoke your consent to a purpose. 400 purpose malformed.",
        "parameters": [
          {
            "name": "purpose",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "A consent purpose, <owner>.<ident>."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleConsentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The consent now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleConsent"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "people"
        ],
        "operationId": "peopleSearch",
        "summary": "Search people by playa name (case-insensitive substring); holders of people.contacts.read also match legal name, phone and contact address, and each such match is audited. Needs people.directory.read. 400 q too_short {min} or too_long {max}, limit range.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "At least 2 bytes, at most 100."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "description": "0 or absent means 20."
          }
        ],
        "responses": {
          "200": {
            "description": "Matches ordered by playa name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleMatchList"
                }
              }
            }
          }
        }
      }
    },
    "/names": {
      "get": {
        "tags": [
          "people"
        ],
        "operationId": "peopleNames",
        "summary": "Playa names of the given people, for the access and audit screens. Any signed-in person. Unknown IDs are omitted. 400 ids too_many {max} over 200.",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated person IDs."
          }
        ],
        "responses": {
          "200": {
            "description": "Names by person ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleNames"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "post": {
        "tags": [
          "people"
        ],
        "operationId": "peopleCreate",
        "summary": "Create a person without an account. Needs people.profiles.manage. 400 playa_name required; 409 (field playa_name, code taken) when another person already uses the name.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleProfileInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleProfile"
                }
              }
            }
          }
        }
      }
    },
    "/{person}": {
      "get": {
        "tags": [
          "people"
        ],
        "operationId": "peopleGet",
        "summary": "A person's profile as you may see it: internal fields with people.directory.read; personal fields and contacts with people.contacts.read (audited); consents with people.profiles.manage. Your own ID behaves as /me. 403 without people.directory.read; 404 for an unknown person.",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleProfile"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "people"
        ],
        "operationId": "peopleUpdate",
        "summary": "Change another person's profile. Needs people.profiles.manage; the regional's required modes are not enforced. Your own ID behaves as PUT /me, except that a holder of people.profiles.manage may rename their own set playa name. A set playa name may be changed (audited with the reason rename) but not cleared (400 playa_name required); 409 (field playa_name, code taken) when another person already uses the name. 404 for an unknown person.",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleProfileInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The profile after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleProfile"
                }
              }
            }
          }
        }
      }
    },
    "/{person}/contacts": {
      "post": {
        "tags": [
          "people"
        ],
        "operationId": "peopleAddContact",
        "summary": "Add an emergency contact for a person. Needs people.profiles.manage (or your own ID).",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleContactInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleContact"
                }
              }
            }
          }
        }
      }
    },
    "/{person}/contacts/{contact}": {
      "put": {
        "tags": [
          "people"
        ],
        "operationId": "peopleUpdateContact",
        "summary": "Replace a person's emergency contact. Needs people.profiles.manage (or your own ID). 404 when it is not theirs.",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "name": "contact",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleContactInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleContact"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "people"
        ],
        "operationId": "peopleRemoveContact",
        "summary": "Remove a person's emergency contact. Needs people.profiles.manage (or your own ID). 404 when it is not theirs.",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "name": "contact",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed."
          }
        }
      }
    },
    "/{person}/consents/{purpose}": {
      "put": {
        "tags": [
          "people"
        ],
        "operationId": "peopleSetConsent",
        "summary": "Record a person's consent, for example from a paper form. Needs people.profiles.manage (or your own ID).",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "name": "purpose",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "A consent purpose, <owner>.<ident>."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleConsentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The consent now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleConsent"
                }
              }
            }
          }
        }
      }
    },
    "/{person}/link-account": {
      "post": {
        "tags": [
          "people"
        ],
        "operationId": "peopleLinkAccount",
        "summary": "Join the account with this login address to a person who has none. Needs people.profiles.manage. 404 (field email, code unknown) when no account has the address; 409 has_account or superuser. The empty profile sign-up made is removed when nothing refers to it.",
        "parameters": [
          {
            "name": "person",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeopleLinkInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeopleLinkResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PeoplePerson": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "playa_name": {
            "type": "string"
          },
          "pronouns": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "legal_name": {
            "type": "string",
            "description": "Only when the viewer may see personal fields (see fields)."
          },
          "phone": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "The login address."
          },
          "has_account": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "playa_name",
          "pronouns",
          "language",
          "has_account",
          "complete"
        ]
      },
      "PeopleContact": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "person_id": {
            "$ref": "#/components/schemas/ID"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "person_id",
          "name",
          "phone",
          "relationship",
          "position",
          "created_at",
          "updated_at"
        ]
      },
      "PeopleContactInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone"
        ]
      },
      "PeopleConsent": {
        "type": "object",
        "properties": {
          "person_id": {
            "$ref": "#/components/schemas/ID"
          },
          "purpose": {
            "type": "string"
          },
          "granted": {
            "type": "boolean"
          },
          "recorded_by": {
            "$ref": "#/components/schemas/ID"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "person_id",
          "purpose",
          "granted",
          "changed_at"
        ]
      },
      "PeopleConsentInput": {
        "type": "object",
        "properties": {
          "granted": {
            "type": "boolean"
          }
        },
        "required": [
          "granted"
        ]
      },
      "PeopleSection": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "<module>.<ident>; the title is module.<module>.section.<ident>.title."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "failed": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "items",
          "failed"
        ]
      },
      "PeopleCan": {
        "type": "object",
        "properties": {
          "edit": {
            "type": "boolean"
          },
          "read_contacts": {
            "type": "boolean"
          },
          "export": {
            "type": "boolean"
          },
          "delete": {
            "type": "boolean"
          },
          "link": {
            "type": "boolean"
          },
          "view_roles": {
            "type": "boolean"
          },
          "view_audit": {
            "type": "boolean"
          }
        },
        "required": [
          "edit",
          "read_contacts",
          "export",
          "delete",
          "link",
          "view_roles",
          "view_audit"
        ]
      },
      "PeoplePolicy": {
        "type": "object",
        "properties": {
          "legal_name": {
            "type": "string",
            "enum": [
              "hidden",
              "optional",
              "required"
            ]
          },
          "phone": {
            "type": "string",
            "enum": [
              "hidden",
              "optional",
              "required"
            ]
          },
          "emergency_contacts": {
            "type": "string",
            "enum": [
              "hidden",
              "optional",
              "required"
            ]
          }
        },
        "required": [
          "legal_name",
          "phone",
          "emergency_contacts"
        ]
      },
      "PeopleProfile": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "#/components/schemas/PeoplePerson"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Which field groups were included: playa_name, pronouns, language, legal_name, phone, contact_email, email, emergency_contacts, consents."
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeopleContact"
            }
          },
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeopleConsent"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeopleSection"
            }
          },
          "can": {
            "$ref": "#/components/schemas/PeopleCan"
          },
          "policy": {
            "$ref": "#/components/schemas/PeoplePolicy"
          },
          "first_prompt": {
            "type": "boolean",
            "description": "Only on GET /me, and only when true: this call recorded the first-sign-in prompt for this session (the person has no playa name and was not yet prompted since signing in). The frame sends them to /people/me?first=1. Absent on every later read of the session, on a read-only copy, for the superuser and on every other route."
          }
        },
        "required": [
          "person",
          "fields",
          "contacts",
          "consents",
          "sections",
          "can",
          "policy"
        ]
      },
      "PeopleProfileInput": {
        "type": "object",
        "properties": {
          "playa_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent or null leaves the field unchanged; an empty string clears it."
          },
          "pronouns": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent or null leaves the field unchanged; an empty string clears it."
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent or null leaves the field unchanged; an empty string clears it."
          },
          "legal_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent or null leaves the field unchanged; an empty string clears it."
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent or null leaves the field unchanged; an empty string clears it."
          },
          "contact_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent or null leaves the field unchanged; an empty string clears it."
          }
        }
      },
      "PeopleMatchList": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/ID"
                },
                "playa_name": {
                  "type": "string"
                },
                "pronouns": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "playa_name",
                "pronouns"
              ]
            }
          }
        },
        "required": [
          "matches"
        ]
      },
      "PeopleNames": {
        "type": "object",
        "properties": {
          "names": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "names"
        ]
      },
      "PeopleLinkInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "PeopleLinkResult": {
        "type": "object",
        "properties": {
          "account_id": {
            "$ref": "#/components/schemas/ID"
          },
          "orphan_id": {
            "$ref": "#/components/schemas/ID"
          },
          "orphan_deleted": {
            "type": "boolean",
            "description": "The empty profile sign-up made was removed; false means it was kept."
          }
        },
        "required": [
          "account_id",
          "orphan_deleted"
        ]
      }
    }
  }
}
