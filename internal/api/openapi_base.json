{
  "tags": [
    {"name": "core", "description": "The shell's own endpoints."}
  ],
  "paths": {
    "/api/modules": {
      "get": {
        "tags": ["core"],
        "operationId": "listModules",
        "summary": "The compiled-in modules and whether each is enabled.",
        "security": [],
        "responses": {
          "200": {
            "description": "Names and enablement only.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModulesResponse"}}}
          }
        }
      }
    },
    "/api/admin/modules": {
      "get": {
        "tags": ["core"],
        "operationId": "adminModules",
        "summary": "The module graph and schema versions. Needs core.modules.read.",
        "responses": {
          "200": {
            "description": "The graph, the build version and each migration set's state.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminModulesResponse"}}}
          }
        }
      }
    },
    "/api/client-errors": {
      "post": {
        "tags": ["core"],
        "operationId": "reportClientErrors",
        "summary": "Report errors the web shell caught.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientErrorBatch"}}}
        },
        "responses": {
          "202": {"description": "Accepted; no body."},
          "400": {"description": "The batch is invalid.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "413": {"description": "The body is over 64 KiB.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "415": {"description": "The body is not JSON.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "429": {"description": "Too many reports; see Retry-After.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["core"],
        "operationId": "openapi",
        "summary": "This document.",
        "security": [],
        "responses": {
          "200": {"description": "The OpenAPI 3.1 document.", "content": {"application/json": {"schema": {"type": "object"}}}},
          "304": {"description": "Not modified."}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "The body of every error response (RFC 9457, application/problem+json).",
        "required": ["status", "code"],
        "properties": {
          "status": {"type": "integer"},
          "code": {"type": "string", "description": "An errs.Kind name (invalid, unauthenticated, permission, not_found, conflict, unavailable, timeout, unsupported, internal) or a shell code (read_only, rate_limited, shutting_down, payload_too_large, unsupported_media_type, cross_origin, misdirected, method_not_allowed)."},
          "ref": {"type": "string", "pattern": "^[0-9A-F]{4}-[0-9A-F]{4}$", "description": "The error reference to quote to a maintainer."},
          "fields": {"type": "array", "items": {"$ref": "#/components/schemas/Field"}}
        }
      },
      "Field": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string", "description": "The dotted path of the input."},
          "code": {"type": "string", "description": "A machine-readable rule code: required, range, one_of, url, host_port, positive, malformed, ..."},
          "params": {"type": "object", "additionalProperties": {"type": "string"}, "description": "The rule's parameters, never the input."},
          "reason": {"type": "string", "description": "The rule in English; shown only when the code has no translation."}
        }
      },
      "ID": {"type": "string", "format": "uuid", "description": "A record identifier in canonical UUID form."},
      "Sensitivity": {"type": "string", "enum": ["public", "internal", "personal", "sensitive"]},
      "TimeRange": {
        "type": "object",
        "description": "The half-open interval [start, end).",
        "required": ["start", "end"],
        "properties": {
          "start": {"type": "string", "format": "date-time"},
          "end": {"type": "string", "format": "date-time"}
        }
      },
      "ModulesResponse": {
        "type": "object",
        "required": ["modules"],
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "enabled"],
              "properties": {"name": {"type": "string"}, "enabled": {"type": "boolean"}}
            }
          }
        }
      },
      "AdminModulesResponse": {
        "type": "object",
        "required": ["version", "graph", "schema"],
        "properties": {
          "version": {"type": "string"},
          "graph": {
            "type": "object",
            "required": ["modules", "edges", "warnings"],
            "properties": {
              "modules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "enabled": {"type": "boolean"},
                    "has_schema": {"type": "boolean"},
                    "permissions": {"type": "array", "items": {"type": "string"}},
                    "settings": {"type": "array", "items": {"type": "string"}},
                    "publishes": {"type": "array", "items": {"type": "string"}},
                    "subscribes": {"type": "array", "items": {"type": "string"}},
                    "provides": {"type": "array", "items": {"type": "string"}},
                    "requires": {"type": "array", "items": {"type": "string"}},
                    "uses": {"type": "array", "items": {"type": "string"}},
                    "defines": {"type": "array", "items": {"type": "string"}},
                    "contributes_to": {"type": "array", "items": {"type": "string"}}
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {"type": "string"},
                    "to": {"type": "string"},
                    "kind": {"type": "string", "enum": ["requires", "uses", "contributes", "subscribes"]},
                    "via": {"type": "string"}
                  }
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"module": {"type": "string"}, "message": {"type": "string"}}
                }
              }
            }
          },
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "set": {"type": "string"},
                "built": {"type": "integer"},
                "applied": {"type": "integer"},
                "current": {"type": "boolean"}
              }
            }
          }
        }
      },
      "ClientErrorBatch": {
        "type": "object",
        "required": ["reports"],
        "properties": {
          "reports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["kind", "message", "occurred_at"],
              "properties": {
                "kind": {"type": "string", "enum": ["crash", "rejection", "screen", "api"]},
                "message": {"type": "string"},
                "stack": {"type": "string"},
                "screen": {"type": "string"},
                "occurred_at": {"type": "string", "format": "date-time"},
                "count": {"type": "integer"},
                "app_version": {"type": "string"},
                "error_ref": {"type": "string"},
                "trace_id": {"type": "string"},
                "api": {
                  "type": "object",
                  "properties": {
                    "method": {"type": "string"},
                    "route": {"type": "string"},
                    "status": {"type": "integer"},
                    "code": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
