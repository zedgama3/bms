# Copy to .env (gitignored) and change the passwords. Development use only.
#
# Two kinds of variable live here: the ports and passwords docker compose substitutes into
# docker-compose.yml, and the BMS_* variables bms itself reads (set -a; . deploy/compose/.env
# before running it). bms reads only the environment: no config file, no flags. Every BMS_*
# name must be a known key (a typo is an error, not a silent default); BMS_TEST_* is the one
# exception, read only by the integration tests, never by bms.

DB_PASSWORD=change-me-db
DB_PORT=5432

SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DEX_PORT=5556

# Observability profile (make observe)
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
ALLOY_UI_PORT=12345
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- bms process configuration (plan/design/config.md). One line per key, at its default
# unless marked; an empty value means unset. Secrets accept a *_FILE variant naming a file
# that holds the value; setting both is an error.

# This copy's name among the copies of one installation (audit's "which copy").
BMS_INSTANCE_NAME=main

# Database. Required; the only key with no default. Secret (carries the password).
# PostgreSQL 16 or newer (plan/design/db.md). The role in the URL needs CREATE on the
# database (bms creates one schema per module) and owns what it creates. pgx also honours
# the PG* variables and ~/.pgpass for anything the URL leaves unset; PGSSLMODE and
# PGSSLROOTCERT are the recommended way to pin TLS to the server. To freeze writes on one
# copy by hand, run on that server:
#   ALTER DATABASE bms SET default_transaction_read_only = on;
# bms then shows the read-only banner and refuses writes within 15 s. A backup of this
# database contains everything, personal data included: protect it like the database.
BMS_DB_URL=postgres://bms:change-me-db@localhost:5432/bms?sslmode=disable
BMS_DB_MAX_CONNS=10
BMS_DB_CONNECT_TIMEOUT=30s
BMS_DB_QUERY_TIMEOUT=10s

# HTTP. TLS is offloaded to a front end (config.md decision 16): bms serves plain HTTP and
# must only be reachable through that front end. The default binds loopback, which needs
# no front end and is what development uses. In a deployment, either keep the loopback
# bind with the front end (Caddy, nginx, cloudflared) on the same host, or bind :8080 on
# a private or compose network and list the front end's address or the network's prefix
# in BMS_HTTP_TRUSTED_PROXIES; any other non-loopback bind is refused. The front end sets
# X-Forwarded-For and X-Forwarded-Proto, strips any it received, and does no
# authentication of its own (bms does). BMS_HTTP_ALLOW_PLAINTEXT=true permits a
# non-loopback bind with no front end, for development only; bms warns at start.
BMS_HTTP_ADDR=127.0.0.1:8080
BMS_HTTP_REQUEST_TIMEOUT=30s
BMS_HTTP_SHUTDOWN_TIMEOUT=15s
BMS_HTTP_MAX_BODY_BYTES=1048576
BMS_HTTP_TRUSTED_PROXIES=
BMS_HTTP_ALLOW_PLAINTEXT=false

# Session signing key. Not set by hand: `bms migrate` generates it into the secrets file
# on a new installation. Setting it here (or via BMS_SESSION_KEY_FILE) is for platforms
# that inject secrets themselves; then no secrets file is written, and a key in both
# places is an error.
#BMS_SESSION_KEY=

# The generated-secrets file. Default <BMS_DATA_DIR>/secrets.json. `bms migrate` creates
# it (mode 0600); bms refuses a file readable by group or others. Back it up separately
# from the database and copy it to every copy of the installation: without it every
# session is invalid.
#BMS_SECRETS_FILE=data/secrets.json

# Logging. Level: debug, info, warn, error. Format: json (what a deployment emits);
# text exists for a developer's terminal.
BMS_LOG_LEVEL=info
BMS_LOG_FORMAT=json

# Local files: the secrets file, the audit spool on a read-only copy. Relative to the
# working directory; a deployment sets an absolute path (BMS_DATA_DIR=/var/lib/bms).
BMS_DATA_DIR=data

# Compiled-in modules not to run, comma-separated. Empty runs every module.
BMS_MODULES_DISABLED=

# Read by integration tests only (go test -tags integration ./...); bms ignores BMS_TEST_*.
# The role in BMS_TEST_DB_DSN needs CREATEDB: each test gets a throw-away database
# (dbtest.TempDB). The compose role is a superuser, so this works as is.
BMS_TEST_DB_DSN=postgres://bms:change-me-db@localhost:5432/bms?sslmode=disable
BMS_TEST_SMTP_ADDR=localhost:1025
