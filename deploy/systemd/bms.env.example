# /etc/bms/bms.env: the configuration of bms.service (mode 640, owner root, group bms).
# It holds the database password, so keep it out of backups that others can read.
# `bms check` prints the configuration it reads and the full catalogue is in docs/operating.md.

# Required. The database URL, or BMS_DB_URL_FILE naming a file that holds it.
BMS_DB_URL=postgres://bms:CHANGE-ME@127.0.0.1:5432/bms?sslmode=disable

BMS_INSTANCE_NAME=main
BMS_DATA_DIR=/var/lib/bms
# Loopback, behind a front end on the same host (deploy/nginx/bms.conf) that terminates TLS
# and sets X-Forwarded-For and X-Forwarded-Proto; trust only that front end.
BMS_HTTP_ADDR=127.0.0.1:8080
BMS_HTTP_TRUSTED_PROXIES=127.0.0.1/32
BMS_LOG_LEVEL=info
BMS_LOG_FORMAT=json

# Optional modules to turn off, comma-separated (hello is the example module).
BMS_MODULES_DISABLED=hello

# Demo mode: a public instance seeded with a fictional regional and shared demo accounts.
# Never on an instance that holds real people's data (docs/operating.md, "Demo mode").
#BMS_DEMO_ENABLED=true
#BMS_DEMO_PUBLIC_URL=https://demo.example.org

# Telemetry export over OTLP/HTTP (docs/telemetry.md). Unset: nothing is exported.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.org:4318
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20CHANGE-ME
#OTEL_SERVICE_NAME=bms
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
