    {
      "type": "stat",
      "title": "Jobs failed in the last hour",
      "description": "Job runs that failed, panicked, lost their lease or had no handler.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(bms_jobs_runs_total{instance=\"$instance\", outcome=~\"failed|panicked|lost_lease|no_handler\"}[1h])) or vector(0)",
          "legendFormat": "failed",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
