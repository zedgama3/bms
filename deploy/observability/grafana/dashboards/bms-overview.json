      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Client errors per minute by kind",
      "description": "Error reports accepted from browsers (bms.client_errors.accepted).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (kind) (rate(bms_client_errors_accepted_total{instance=\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{kind}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
