      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Chunk-load failures by app version",
      "description": "A lazy route module failed to load: usually a deploy left stale tabs open.",
